# Flask contact backend environment variables
# Copy this file to .env and configure with your credentials

FLASK_ENV=development
PORT=5000
SECRET_KEY=dev-secret-key-replace-in-production

# Email delivery settings (optional - if omitted, messages are logged locally)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_RECEIVER=rawatkapish942@gmail.com

